# Packmol packing for the M3 tier-1 bulk electrolyte box (LP30-class).
# 2 Li+ + 2 PF6- + 14 EC + 11 DMC = 288 atoms in a 15 A cube (~0.98 M LiPF6,
# EC:DMC ~ 1:1 v/v). Run in a directory containing li.xyz, pf6.xyz, ec.xyz,
# dmc.xyz:  packmol < packmol_bulk.inp
tolerance 2.0
filetype xyz
output bulk_lp30_288.xyz
seed 20250819

structure li.xyz
  number 2
  inside cube 1.0 1.0 1.0 13.0
end structure

structure pf6.xyz
  number 2
  inside cube 1.0 1.0 1.0 13.0
end structure

structure ec.xyz
  number 14
  inside cube 1.0 1.0 1.0 13.0
end structure

structure dmc.xyz
  number 11
  inside cube 1.0 1.0 1.0 13.0
end structure
