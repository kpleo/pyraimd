# Packmol spec for the M3 smoke-test mini electrolyte box (~106 atoms).
# 1 Li+ + 1 PF6- + 5 EC + 4 DMC in an 11.8 A cube (~1.1 M) — NOT for physics,
# only to validate the remote adaptive loop end-to-end (fast SCF labels).
# Run: packmol < packmol_mini.inp
tolerance 2.0
filetype xyz
output mini_electrolyte_106.xyz
seed 20250819

structure li.xyz
  number 1
  inside cube 1.0 1.0 1.0 9.8
end structure

structure pf6.xyz
  number 1
  inside cube 1.0 1.0 1.0 9.8
end structure

structure ec.xyz
  number 5
  inside cube 1.0 1.0 1.0 9.8
end structure

structure dmc.xyz
  number 4
  inside cube 1.0 1.0 1.0 9.8
end structure
